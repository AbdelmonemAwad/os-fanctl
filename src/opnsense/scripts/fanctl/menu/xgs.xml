<menu>
    <!--
        The place used when os-xgs-npu is installed, which is to say on an XGS appliance: the
        family's pages sit together in its XGS section, in os-xgs-npu's order, which is OPNsense's own -
        the appliance's pages (10-45), the family's plugins by subject (50-58: hardware, the system,
        protection, reports), Updates and Problem Reports (80, 85), the two logs (90, 91), About (99).
        The section's name and attributes are os-xgs-npu's own, so the two files make one section.
        place-menu.sh chooses between this file and own.xml.
    -->
    <XGS VisibleName="XGS" cssClass="fa fa-microchip fa-fw" order="35">
        <FanCtl order="51" VisibleName="Fan Control" url="/ui/fanctl"/>
    </XGS>
</menu>
